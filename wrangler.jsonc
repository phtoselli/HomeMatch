// Cloudflare Worker that serves HomeMatch on home-match.pedrotoselli.com.
// Static app from apps/web/dist; /api/* is forwarded to the API on Vercel (apps/edge/src/index.ts).
// Build: `npm run build:cloudflare`. Deploy: `npx wrangler deploy` (Workers Builds runs both on every push to main).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-match",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "API_ORIGIN": "https://home-match-delta.vercel.app",
  },
  "routes": [{ "pattern": "home-match.pedrotoselli.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
}
